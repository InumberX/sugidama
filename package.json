{
  "name": "@InumberX/sugidama",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy-development": "wrangler deploy --env=development",
    "deploy-production": "wrangler deploy --env=production",
    "bundle": "wrangler deploy --dry-run --env=production --outdir=tmp/worker",
    "test": "NODE_ENV=test remix test",
    "typecheck": "tsc -b",
    "routes": "remix routes --table",
    "doctor": "remix doctor",
    "format": "oxfmt --check \"./{app,workers}/**/*.{ts,tsx}\"",
    "format-fix": "oxfmt --write \"./{app,workers}/**/*.{ts,tsx}\"",
    "lint": "oxlint . --max-warnings=0",
    "lint-fix": "oxlint --fix .",
    "stylelint": "stylelint \"./public/**/*.css\"",
    "stylelint-fix": "stylelint --fix \"./public/**/*.css\"",
    "pre-commit": "npm run typecheck && npm run format-fix && npm run lint-fix && npm run stylelint-fix",
    "upgrade": "npx npm-check-updates -u",
    "upgrade-check": "npx npm-check-updates"
  },
  "dependencies": {
    "@inumberx/cloudflare-workers-basic-auth": "^1.0.1",
    "remix": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "7.0.2",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "volta": {
    "node": "24.16.0"
  }
}
