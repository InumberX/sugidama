{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The top level is what `wrangler dev` runs, and it carries no `vars` or
  // `define`. Its name must not be a deployed Worker's: a bare `wrangler deploy`
  // (no --env) would otherwise replace production with a Worker that has no
  // vars, localhost canonical URLs and the shell's NODE_ENV. Under this name it
  // creates a stray Worker instead, and workers/wrangler.test.ts pins that.
  "name": "sugidama-local",
  "compatibility_date": "2026-05-04",
  // `nodejs_compat` supplies the `node:` built-ins some remix packages import,
  // and (with a compatibility date of 2025-04-01 or later) fills `process.env`
  // from `vars` and secrets, which is what app/env.ts reads.
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "workers_dev": false,
  // Compiles the browser modules into public/client/ before `wrangler dev` (and
  // again whenever app/ changes) and before every deploy, dry runs included.
  "build": {
    "command": "npm run build-client",
    "watch_dir": "app",
  },
  "assets": {
    // Root `public/` is served as-is. There is no build step, so there is no
    // `build/client` to point at.
    "directory": "./public",
    "binding": "ASSETS",
    // Matching files in public/ are served from the edge before the Worker
    // runs. Only staging has Basic auth, so only `env.development` routes them
    // through the Worker; with Smart Placement the Worker may run far from the
    // visitor, and production's assets would pay for the detour.
    "run_worker_first": false,
  },
  "observability": {
    "enabled": true,
  },
  // Every deployed Worker is a production build — staging included, which is
  // kept out of search engines by NO_INDEX, not by NODE_ENV. Wrangler would
  // otherwise take NODE_ENV from the deploying shell first, so a stray
  // `NODE_ENV=development` would ship /dev/ui to the live site.
  //
  // Neither `define` nor `vars` is inherited by an environment, so each one
  // repeats both in full, and workers/wrangler.test.ts checks that it does.
  // The top level sets neither: `wrangler dev` keeps wrangler's "development"
  // and app/env.ts's local defaults (overridable from `.dev.vars`).
  //
  // BUILD_ID and DEPLOYED_AT are per deploy, so scripts/deploy.sh (behind
  // `npm run deploy-*`) passes them with `--var` instead.
  //
  // `vars` are public — this repository is, and the dashboard shows them in plain
  // text. Only values a visitor can already see belong here. Credentials are
  // Worker secrets (`wrangler secret put`), never vars; see CLAUDE.md.
  //
  // Smart Placement runs the production Worker near the Kuroco API rather than
  // near each visitor. Run from every data center, a Worker spreads its
  // requests over Kuroco's CDN, which likely made more of them miss its cache
  // (see CLAUDE.md, Cloudflare Workers). Staging leaves it off: its assets go
  // through the Worker for Basic auth, which wrangler warns would slow them
  // down once placed, and its traffic is too small for Smart Placement to move
  // it anyway.
  //
  // An environment's `assets` replaces the top level's whole, so staging
  // repeats `directory` and `binding`.
  "env": {
    "development": {
      "name": "dev-sugidama",
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        // Route every request through the Worker first so the Basic-auth gate
        // in workers/handler.ts also covers static assets (CSS/images).
        "run_worker_first": true,
      },
      "define": { "process.env.NODE_ENV": "\"production\"" },
      "vars": {
        "SITE_URL": "https://dev-sugidama.afterworks.jp",
        "NO_INDEX": "true",
        "SITE_NAME": "Sugidama(Staging)",
        "API_URL": "https://afterworks.g.kuroco.app/rcms-api/7",
        "GOOGLE_ANALYTICS_ID": "G-P7SXGX2CCT",
      },
    },
    "production": {
      "name": "sugidama",
      "placement": { "mode": "smart" },
      "define": { "process.env.NODE_ENV": "\"production\"" },
      "vars": {
        "SITE_URL": "https://sugidama.afterworks.jp",
        "NO_INDEX": "false",
        "SITE_NAME": "Sugidama",
        "API_URL": "https://afterworks.g.kuroco.app/rcms-api/8",
        "GOOGLE_ANALYTICS_ID": "G-VQP1LGZ7QV",
      },
    },
  },
}
