{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sugidama",
  "compatibility_date": "2026-05-04",
  // `nodejs_compat` supplies the `node:` built-ins some remix packages import,
  // and (with a compatibility date of 2025-04-01 or later) fills `process.env`
  // from `vars` and secrets, which is what app/env.ts reads.
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "workers_dev": false,
  "assets": {
    // Root `public/` is served as-is. There is no build step, so there is no
    // `build/client` to point at.
    "directory": "./public",
    "binding": "ASSETS",
    // Route every request through the Worker first so the Basic-auth gate in
    // workers/handler.ts also covers static assets (CSS/images). Without this,
    // matching files in public/ are served before the Worker runs.
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
  },
  // Every deployed Worker is a production build — staging included, which is
  // kept out of search engines by NO_INDEX, not by NODE_ENV. Wrangler would
  // otherwise take NODE_ENV from the deploying shell first, so a stray
  // `NODE_ENV=development` would ship /dev/ui to the live site.
  //
  // Neither `define` nor `vars` is inherited by an environment, so each one
  // repeats both in full, and workers/wrangler.test.ts checks that it does.
  // The top level sets neither: `wrangler dev` keeps wrangler's "development"
  // and app/env.ts's local defaults (overridable from `.dev.vars`).
  //
  // BUILD_ID and DEPLOYED_AT are per deploy, so `npm run deploy-*` passes them
  // with `--var` instead.
  "env": {
    "development": {
      "name": "dev-sugidama",
      "define": { "process.env.NODE_ENV": "\"production\"" },
      "vars": {
        "SITE_URL": "https://dev-sugidama.afterworks.jp",
        "NO_INDEX": "true",
        "SITE_NAME": "Sugidama(Staging)",
        "API_URL": "https://afterworks.g.kuroco.app/rcms-api/7",
        "GOOGLE_ANALYTICS_ID": "G-P7SXGX2CCT",
      },
    },
    "production": {
      "name": "sugidama",
      "define": { "process.env.NODE_ENV": "\"production\"" },
      "vars": {
        "SITE_URL": "https://sugidama.afterworks.jp",
        "NO_INDEX": "false",
        "SITE_NAME": "Sugidama",
        "API_URL": "https://afterworks.g.kuroco.app/rcms-api/8",
        "GOOGLE_ANALYTICS_ID": "G-VQP1LGZ7QV",
      },
    },
  },
}
